<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TextField fx:id="pantalla" prefHeight="50.0" prefWidth="300.0" />
      <Button fx:id="botonLimpiar" mnemonicParsing="false" onAction="#limpiar" prefHeight="30.0" prefWidth="70.0" text="C">
         <VBox.margin>
            <Insets left="270.0" />
         </VBox.margin>
      </Button>
      <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="7" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="8" GridPane.columnIndex="1" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="9" GridPane.columnIndex="2" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="/" GridPane.columnIndex="3" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="4" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="*" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="1" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="2" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="3" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="0" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="." GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#calcular" prefHeight="50.0" prefWidth="70.0" text="=" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#pulsarBoton" prefHeight="50.0" prefWidth="70.0" text="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />
         </children>
      </GridPane>
   </children>
</VBox>
